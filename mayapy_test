#!/usr/bin/env bash

set -euo pipefail
# -----------------------------
# Configuration
# -------------
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Load .env if exists (MAYAPY should be defined there)
set -a
[ -f "$SCRIPT_DIR/.env" ] && source "$SCRIPT_DIR/.env"
set +a

if [ -z "${MAYAPY:-}" ]; then
    echo "MAYAPY not set. Define it in .env"
    exit 1
fi

echo "Using mayapy: $MAYAPY"
# -----------------------------
#  Temporary Installation
# -----------------------------
BUILD_DIR="$SCRIPT_DIR/build/site-packages"
WHEEL_BUILD_DIR="$BUILD_DIR/wheel_build"
rm -rf "$BUILD_DIR"
mkdir -p $WHEEL_BUILD_DIR

echo "Installing puppet and pytest dependencies into temporary location: $BUILD_DIR"
uv pip install \
  --python "$MAYAPY" \
  --target "$BUILD_DIR" \
  --group dev \
  "$SCRIPT_DIR"

unset PATH
unset PYTHONPATH
# Prepend temp site to PYTHONPATH so mayapy can see all installed packages
export PYTHONPATH="$BUILD_DIR"
# -----------------------------
#  Run Tests
# -----------------------------
"$MAYAPY" -m pytest -vvv "$SCRIPT_DIR/tests" "$@"
EXIT_CODE=$?

exit $EXIT_CODE
